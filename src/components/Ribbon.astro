---
/**
 * Лента цен на главной (решение владельца): лента на всех экранах — видно три карточки, на планшете две,
 * на телефоне одна по центру; замкнута, кнопки «назад / вперёд» и номер «01 / 09» под ней.
 * Режим ленты и его стили — общие для всех лент: scripts/ribbon.ts, styles/ribbon.css, RibbonControls.
 * Без JS — обычная сетка карточек (на телефоне — .rail), кнопок нет.
 */
import RibbonControls from './RibbonControls.astro';

interface Props {
  /** id ряда — для aria-controls кнопок */
  id: string;
  /** сколько карточек — для номера */
  count: number;
  class?: string;
}

const { id, count, class: className } = Astro.props;
---

<div class:list={['ribbon', className]} data-ribbon>
  <div class="ribbon__viewport" data-reveal>
    <ul class="ribbon__track rail" id={id} role="list">
      <slot />
    </ul>
  </div>
  <RibbonControls id={id} count={count} />
</div>

<style>
  /* ---------- Без JS — сетка: по три, на планшете по две (нечётная последняя — на всю ширину ряда),
     на телефоне — лента .rail (base.css) ---------- */
  .ribbon__track {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .ribbon__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ribbon__track > :global(li:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .ribbon__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
