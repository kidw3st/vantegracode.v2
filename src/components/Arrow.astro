---
/** Тонкая стрелка ссылок: линия 1,25 px */
interface Props {
  class?: string;
  direction?: 'right' | 'up-right' | 'down';
}
const { class: className, direction = 'right' } = Astro.props;
---

<svg
  class:list={['arrow', `arrow--${direction}`, className]}
  viewBox="0 0 20 20"
  width="20"
  height="20"
  aria-hidden="true"
  focusable="false"
>
  <path d="M2.5 10h14.5M11.5 4.5L17 10l-5.5 5.5"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .arrow--up-right {
    rotate: -45deg;
  }

  .arrow--down {
    rotate: 90deg;
  }
</style>
