---
/** Тонкая стрелка ссылок — форма arrow-right из Lucide (как иконки сайта), линия ~1,25 px */
interface Props {
  class?: string;
  direction?: 'right' | 'left' | 'up-right' | 'down';
}
const { class: className, direction = 'right' } = Astro.props;
---

<svg
  class:list={['arrow', `arrow--${direction}`, className]}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  aria-hidden="true"
  focusable="false"
>
  <path d="M5 12h14M12 5l7 7-7 7"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .arrow--left {
    rotate: 180deg;
  }

  .arrow--up-right {
    rotate: -45deg;
  }

  .arrow--down {
    rotate: 90deg;
  }
</style>
