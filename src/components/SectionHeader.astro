---
/**
 * Заголовок секции — по центру блока (решение владельца): подпись «02 — Услуги»,
 * крупный заголовок, под ним поясняющий текст и ссылка «Все …».
 * neon — по линии-разделителю ездят два светящихся импульса (только блок под надписью VANTEGRA).
 */
import ArrowLink from './ArrowLink.astro';
import { t } from '../lib/typograf.ts';

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  link?: { href: string; label: string };
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
  /** неоновые импульсы на линии-разделителе */
  neon?: boolean;
}

const { eyebrow, title, text, link, as: Heading = 'h2', id, class: className, neon = false } = Astro.props;
---

<header class:list={['sh', className]} data-reveal="stagger">
  <p class="eyebrow sh__eyebrow">{t(eyebrow)}</p>
  <Heading class="sh__title" id={id}>{t(title)}</Heading>
  {
    (text || link) && (
      <div class="sh__aside">
        {text && <p class="sh__text">{t(text)}</p>}
        {link && <ArrowLink class="sh__link" href={link.href} label={link.label} />}
      </div>
    )
  }
  {
    neon && (
      <span class="sh__neon" aria-hidden="true">
        <span class="sh__pulse" />
        <span class="sh__pulse sh__pulse--back" />
      </span>
    )
  }
</header>

<style>
  /* Всё по центру блока; линия-разделитель расходится от центра, заголовок раскрывается из неё занавесом */
  .sh {
    position: relative;
    display: grid;
    justify-items: center;
    row-gap: var(--space-5);
    padding-top: var(--space-6);
    margin-bottom: clamp(var(--space-8), 6vw, var(--space-9));
    text-align: center;
  }

  .sh::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: var(--hairline) solid var(--rule);
  }

  /* Разрядка заглавных добавляет пробел после последней буквы — возвращаем его слева, чтобы строка стояла по центру */
  .sh__eyebrow {
    margin-bottom: var(--space-2);
    padding-inline-start: var(--ls-label);
  }

  .sh__title {
    justify-self: center;
    padding-inline-start: var(--ls-heading);
  }

  @media (max-width: 480px) {
    .sh__title {
      padding-inline-start: 0.08em;
    }
  }

  .sh__aside {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
  }

  .sh__text {
    color: var(--text-muted);
    max-width: 52ch;
  }

  :global(.js) .sh::before {
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-in-out);
  }

  :global(.js) .sh__title {
    opacity: 1;
    transform: none;
    clip-path: inset(-25% 50% -25% 50%);
    transition: clip-path var(--dur-curtain) var(--ease-in-out) var(--delay-curtain);
  }

  .sh:global(.is-in)::before {
    transform: none;
  }

  .sh:global(.is-in) .sh__title {
    clip-path: inset(-25% -4% -25% -4%);
  }

  /* ---------- Неон на линии (решение владельца, по мотивам Neon Border) ----------
     Два светящихся отрезка мелом скользят по линии навстречу друг другу: разгон и торможение у концов.
     Свечение — две размытые копии отрезка; исключение из правила «без свечений» — только здесь. */
  .sh__neon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    /* свечение вверх и вниз, по краям линии обрезаем */
    clip-path: inset(-40px 0);
  }

  :global(.js) .sh__neon {
    opacity: 0;
    transform: none;
    transition: opacity var(--dur-slow) var(--ease-out) var(--dur-slow);
  }

  .sh:global(.is-in) .sh__neon {
    opacity: 1;
  }

  .sh__pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 34%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--chalk) 50%, transparent);
    mix-blend-mode: plus-lighter;
    animation: neon-glide 5.6s var(--ease-in-out) infinite;
  }

  .sh__pulse::before,
  .sh__pulse::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    background: inherit;
    translate: 0 -50%;
  }

  .sh__pulse::before {
    height: 6px;
    filter: blur(4px);
    opacity: 0.7;
  }

  .sh__pulse::after {
    height: 24px;
    filter: blur(14px);
    opacity: 0.35;
  }

  /* второй импульс — зеркально, навстречу первому */
  .sh__pulse--back {
    animation-delay: -2.8s;
  }

  /* отрезок шириной 34 % ходит от левого края линии до правого и обратно */
  @keyframes neon-glide {
    0%,
    100% {
      transform: translateX(0);
    }

    50% {
      transform: translateX(194.12%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sh__neon {
      display: none;
    }

    :global(.js) .sh::before {
      transform: none;
      transition: none;
    }

    :global(.js) .sh__title {
      clip-path: none;
      transition: none;
    }
  }
</style>
