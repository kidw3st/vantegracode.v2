---
/**
 * Подвал (решение владельца 04.10.2026, по его наброску): слева — вертикальный логотип, знак вращается
 * 3D-моделью первого экрана (scripts/mark-3d.ts), под ним надпись VANTEGRA; справа, по верхней линии
 * с логотипом, — колонки «Разделы», «Услуги», «Контакты» (капсулы с заливкой, как в блоке с формой);
 * внизу — строка «© год Vantegra · Политика конфиденциальности».
 * На телефоне и планшете логотип — по центру над колонками.
 * Строки «Обсудим проект →» нет: блок с формой стоит прямо над подвалом. Подписи — Geologica, пепел.
 * Верхняя линия подвала — во всю ширину экрана, с неоновыми импульсами, как линия под VANTEGRA:
 * ощущается как конец листа (решение владельца 04.10.2026; рисует scripts/neon.ts).
 */
import ContactList from './ContactList.astro';
import Logo from './Logo.astro';
import { nav, site } from '../data/site.ts';
import { ui } from '../data/ui.ts';
import { getServices } from '../lib/content.ts';
import { getText } from '../lib/fill.ts';
import { t } from '../lib/typograf.ts';

const services = await getServices();
const text = await getText();
---

<footer class="footer" data-neon-host>
  <canvas class="footer__neon" aria-hidden="true" data-neon></canvas>
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label={ui.homeLabel}>
          {/* знак — 3D-модель первого экрана; до первого кадра, без WebGL и при reduced motion — плоский SVG */}
          <span class="footer__art" data-mark-art>
            <Logo variant="mark" width={200} cssWidth="var(--footer-logo)" minWidth={140} loading="lazy" class="footer__mark" />
            <canvas
              class="footer__canvas"
              width="450"
              height="350"
              aria-hidden="true"
              data-mark-canvas="footer"
              data-src="/media/hero-mark.bin"></canvas>
            <Logo
              variant="wordmark"
              width={198}
              cssWidth="calc(var(--footer-logo) * 0.99009)"
              minWidth={138}
              loading="lazy"
              class="footer__wordmark"
            />
          </span>
        </a>
      </div>

      <nav class="footer__col footer__col--nav" id="footer-nav" aria-labelledby="footer-sections">
        <p class="eyebrow footer__heading" id="footer-sections">{ui.footerSections}</p>
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a class="footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer__col footer__col--services" aria-labelledby="footer-services">
        <p class="eyebrow footer__heading" id="footer-services">{ui.footerServices}</p>
        <ul role="list">
          {
            services.map((service) => (
              <li>
                <a class="footer__link" href={`/uslugi/${service.id}/`}>
                  {t(service.data.title)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col footer__col--contacts">
        <p class="eyebrow footer__heading">{ui.footerContacts}</p>
        <ContactList pills labels={false} />
        {site.hours && <p class="footer__note">{t(site.hours)}</p>}
        {
          site.socials.length > 0 && (
            <ul class="footer__socials" role="list">
              {site.socials.map((social) => (
                <li>
                  <a class="footer__link" href={social.url} target="_blank" rel="noopener noreferrer">
                    {social.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="footer__bottom label">
      <span>{text(ui.copyright)}</span>
      <a class="footer__link footer__link--small" href="/politika-konfidencialnosti/">{t(ui.privacy)}</a>
      {site.requisites && <span>{t(site.requisites)}</span>}
    </div>

  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: var(--space-9) var(--space-7);
    border-top: var(--hairline) solid var(--graphite);
  }

  /* до 767 px кнопка «Наверх» заходит на колонку текста: в самом низу страницы она встаёт
     под строкой ©, а не поверх (24 px от низа + 48 px кнопка + зазор) */
  @media (max-width: 767px) {
    .footer {
      padding-bottom: calc(24px + 48px + var(--space-5) + env(safe-area-inset-bottom));
    }
  }

  /* холст импульсов: 80 px по высоте, линия — ровно посередине, как у заголовка с неоном */
  .footer__neon {
    position: absolute;
    top: -40px;
    left: 0;
    width: 100%;
    height: 80px;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__neon {
      display: none;
    }
  }

  /* ---------- Вертикальный логотип: знак, под ним надпись — как на первом экране ----------
     Геометрия из SVG владельца: блок 962,81 × 939,71; знак — сверху во всю ширину, надпись — со сдвигом
     0,004955 и 0,75985 ширины; холст 3D — кадр камеры 2,25 × 1,75 ед. при ширине знака 2 ед. */
  .footer__brand {
    display: flex;
    justify-content: center;
    grid-column: 1 / -1;
  }

  .footer__logo {
    --footer-logo: clamp(140px, 12vw, 190px);

    display: block;
  }

  .footer__art {
    position: relative;
    display: block;
    width: var(--footer-logo);
    aspect-ratio: 962.81 / 939.71;
  }

  .footer__art :global(.footer__mark) {
    position: absolute;
    left: 0;
    top: 0;
  }

  .footer__canvas {
    position: absolute;
    left: calc(var(--footer-logo) * -0.0625);
    top: calc(var(--footer-logo) * -0.05683);
    width: calc(var(--footer-logo) * 1.125);
    height: calc(var(--footer-logo) * 0.875);
    max-width: none;
    pointer-events: none;
  }

  .footer__art:not(.is-3d) .footer__canvas,
  .footer__art.is-3d :global(.footer__mark) {
    visibility: hidden;
  }

  .footer__art :global(.footer__wordmark) {
    position: absolute;
    left: calc(var(--footer-logo) * 0.004955);
    top: calc(var(--footer-logo) * 0.75985);
  }

  /* ---------- Колонки: телефон и планшет — логотип по центру, разделы и услуги рядом, контакты под ними;
     десктоп — логотип и три колонки в ряд, по верхней линии ---------- */
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--column-gap);
    padding-bottom: var(--space-9);
  }

  .footer__col--contacts {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .footer__brand,
    .footer__col--contacts {
      grid-column: auto;
    }

    .footer__brand {
      justify-content: flex-start;
    }
  }

  .footer__heading {
    margin-bottom: var(--space-5);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-1);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    font-size: var(--fs-list);
    color: var(--ash);
    transition: color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--chalk);
    }
  }

  .footer__note,
  .footer__socials {
    margin-top: var(--space-5);
  }

  .footer__note {
    font-size: var(--fs-list);
    color: var(--ash);
  }

  /* ---------- Нижняя строка: ©, политика ---------- */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--hairline) solid var(--graphite);
    color: var(--ash);
  }

  .footer__link--small {
    min-height: var(--tap);
    font-size: inherit;
  }
</style>
