---
/**
 * Шапка — плавающая капсула (правка владельца 03.10.2026, ориентир — полоска-шапка).
 * - форма pill, как у кнопок и тегов: отсылка к орбите; кнопка внутри — концентрично;
 * - над первым экраном капсула прозрачная, виден только контур графитом;
 *   после прокрутки на 24 px — подложка сажи 95 % с размытием;
 * - при загрузке контур прорисовывается, как эхо-орбиты, ссылки проявляются по очереди;
 * - под ссылками скользит линия 1 px: к наведённой и обратно к активной, при переходе — к новой.
 * Логотип с охранным полем: капсула 56 px и блок 140 px, от 768 px — 64 px и 156 px.
 * Сохраняется между переходами (transition:persist); активную ссылку обновляет menu.ts.
 */
import Button from './Button.astro';
import Logo from './Logo.astro';
import { nav, site } from '../data/site.ts';
import { ui } from '../data/ui.ts';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="header" data-header transition:persist="site-header">
  <div class="header__bar">
    <span class="header__fill" aria-hidden="true"></span>
    <svg class="header__outline" aria-hidden="true" focusable="false">
      <rect class="header__outline-rect" x="0" y="0" width="100%" height="100%" rx="28" ry="28" pathLength="1"></rect>
    </svg>

    <a class="header__logo" href="/" aria-label={ui.homeLabel} data-header-logo>
      <Logo
        variant="horizontal"
        width={156}
        cssWidth="var(--header-logo)"
        minWidth={140}
        class="header__lockup"
        fetchpriority="high"
      />
      <span class="header__mark" data-header-mark></span>
      <template data-mark-template>
        <Logo variant="mark" width={57} class="header__mark-img" loading="lazy" />
      </template>
    </a>

    <nav class="header__nav" aria-label={ui.navLabel}>
      <ul role="list" data-nav-list>
        {
          nav.map((item, i) => (
            <li style={`--i: ${i + 1}`}>
              <a class="header__link" href={item.href} data-nav-link aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="header__indicator" aria-hidden="true" data-nav-indicator></span>
    </nav>

    <div class="header__actions">
      <Button class="header__cta" href={site.cta.discussHref} variant="primary" size="sm" label={site.cta.discuss} />
      <button
        class="header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={ui.menuOpen}
        data-menu-toggle
        data-label-open={ui.menuOpen}
        data-label-close={ui.menuClose}
      >
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
      </button>
      <a class="header__fallback" href="#footer-nav">{ui.menuLabel}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    padding-top: var(--bar-top);
    pointer-events: none;
  }

  /* Капсула: края логотипа совпадают с сеткой, справа — концентрично кнопке */
  .header__bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    width: min(100% - 2 * (var(--gutter) - var(--bar-pad)), var(--maxw) + 2 * var(--bar-pad));
    height: var(--bar-h);
    margin-inline: auto;
    padding-left: var(--bar-pad);
    padding-right: var(--bar-inset);
    border-radius: var(--radius-pill);
    pointer-events: auto;
  }

  .header__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--header-bg);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .header.is-scrolled .header__fill {
    opacity: 1;
  }

  :global(.menu-open) .header__fill {
    opacity: 0;
  }

  .header__outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .header__outline-rect {
    fill: none;
    stroke: var(--graphite);
    stroke-width: var(--hairline);
  }

  .header__logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: var(--tap);
  }

  .header__logo :global(.header__lockup) {
    transition: opacity var(--dur-menu) var(--ease-out);
  }

  /* Пока открыто меню, вместо горизонтального блока — знак той же высоты */
  .header__mark {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(var(--header-logo) * 733.04 / 2632.63);
    aspect-ratio: 962.81 / 733.04;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-menu) var(--ease-out);
  }

  .header__mark :global(img) {
    width: 100%;
    height: 100%;
  }

  :global(.menu-open) .header__logo :global(.header__lockup) {
    opacity: 0;
  }

  :global(.menu-open) .header__mark {
    opacity: 1;
  }

  /* ---------- Навигация ---------- */

  .header__nav {
    position: relative;
    display: none;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-5), 2vw, var(--space-7));
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    color: var(--ash);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__link[aria-current] {
    color: var(--chalk);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__link:hover {
      color: var(--chalk);
    }
  }

  /* Линия под ссылкой: 1 px, двигается transform — без JS стоит статично под активной */
  .header__indicator {
    position: absolute;
    left: 0;
    bottom: 10px;
    width: 1px;
    border-top: var(--hairline) solid var(--chalk);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
  }

  .header__indicator.is-ready {
    transition:
      translate var(--dur-link) var(--ease-out),
      scale var(--dur-link) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  :global(html:not(.js)) .header__link[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: var(--ls-button);
    bottom: 10px;
    border-top: var(--hairline) solid currentColor;
  }

  /* ---------- Справа: кнопка и бургер ---------- */

  .header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-3);
  }

  .header__actions :global(.header__cta) {
    display: none;
  }

  .header__burger {
    display: none;
    place-content: center;
    gap: 7px;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-pill);
  }

  :global(.js) .header__burger {
    display: grid;
  }

  .header__burger-line {
    display: block;
    width: 22px;
    border-top: var(--hairline) solid var(--chalk);
    transition:
      translate var(--dur-menu) var(--ease-out),
      rotate var(--dur-menu) var(--ease-out);
  }

  .header__burger[aria-expanded='true'] .header__burger-line:first-child {
    translate: 0 4px;
    rotate: 45deg;
  }

  .header__burger[aria-expanded='true'] .header__burger-line:last-child {
    translate: 0 -4px;
    rotate: -45deg;
  }

  /* Без JS бургер не работает — ссылка ведёт к навигации в подвале */
  .header__fallback {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-3);
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
  }

  :global(.js) .header__fallback {
    display: none;
  }

  @media (min-width: 768px) {
    .header__outline-rect {
      rx: 32px;
      ry: 32px;
    }
  }

  @media (min-width: 1200px) {
    .header__bar {
      grid-template-columns: 1fr auto 1fr;
    }

    .header__nav {
      display: block;
    }

    .header__actions :global(.header__cta) {
      display: inline-flex;
    }

    :global(.js) .header__burger,
    .header__fallback {
      display: none;
    }
  }

  /* ---------- Появление при загрузке: контур прорисовывается, ссылки проявляются ---------- */

  :global(.js) .header__outline-rect {
    animation: bar-draw var(--dur-logo) var(--ease-in-out) both;
  }

  :global(.js) .header__logo {
    animation: logo-in var(--dur) var(--ease-out) var(--stagger) backwards;
  }

  :global(.js) .header__nav li,
  :global(.js) .header__actions {
    animation: bar-item var(--dur) var(--ease-out) backwards;
    animation-delay: calc(var(--stagger) * 2 + var(--i, 8) * var(--stagger) * 0.5);
  }

  @keyframes bar-draw {
    0% {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
    }
    99.9% {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }

  @keyframes bar-item {
    from {
      opacity: 0;
      transform: translateY(calc(var(--shift-hero) * -1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__burger-line,
    .header__indicator.is-ready {
      transition: opacity var(--dur-fast) linear;
    }

    :global(.js) .header__outline-rect {
      animation: none;
    }

    :global(.js) .header__logo,
    :global(.js) .header__nav li,
    :global(.js) .header__actions {
      animation: fade var(--dur-fast) linear backwards;
    }
  }
</style>
