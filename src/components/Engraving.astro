---
/**
 * Гравюра из lib/engraving.ts: штрих двух версий (ночная — светлые линии ложатся на свет,
 * дневная — тёмные ложатся в тень) и контуры поверх. В каждой теме видна своя версия.
 * Прорисовка ведётся переменной --ink (0…1, по умолчанию 1 — готово): сначала проводятся контуры,
 * затем штрих набирает плотность слоями a → d, как гравёр проходит доску в несколько проходов.
 */
import type { Engraved } from '../lib/engraving.ts';

interface Props {
  art: Engraved;
  class?: string;
}

const { art, class: className } = Astro.props;
// с какого --ink проявляется слой штриха
const LAYERS = [
  ['a', 0.25],
  ['b', 0.42],
  ['c', 0.59],
  ['d', 0.76],
] as const;
---

<svg class:list={['eng', className]} viewBox={`0 0 ${art.width} ${art.height}`} aria-hidden="true" focusable="false">
  {
    (['night', 'day'] as const).map((side) => (
      <g class={`eng__${side}`}>
        {LAYERS.map(([layer, from]) => (
          <path class:list={['eng__hatch', `eng__hatch--${layer}`]} d={art[side][layer]} style={`--from: ${from}`} />
        ))}
      </g>
    ))
  }
  {art.contours.map((d) => <path class="eng__line" d={d} pathLength="1" />)}
</svg>

<style>
  .eng {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--chalk);
  }

  .eng__hatch {
    stroke-width: 1.3;
    stroke-linecap: round;
    opacity: clamp(0, (var(--ink, 1) - var(--from)) * 5, 1);
  }

  .eng__hatch--c,
  .eng__hatch--d {
    stroke-width: 2.6;
  }

  .eng__line {
    stroke-width: 1.4;
    stroke-opacity: 0.6;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc((1 - clamp(0, var(--ink, 1) * 3.4, 1)) * 1px);
  }

  :global(:root[data-theme='light']) .eng__night,
  :global(:root:not([data-theme='light'])) .eng__day {
    display: none;
  }
</style>
