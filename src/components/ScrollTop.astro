---
/**
 * Кнопка «Наверх»: кружок внизу справа, появляется ниже первого экрана.
 * Тонкое кольцо вокруг показывает, сколько страницы прокручено (stroke-dashoffset). Логика — scripts/to-top.ts.
 */
import Icon from './Icon.astro';
import { ui } from '../data/ui.ts';
---

<button class="to-top" type="button" aria-label={ui.toTop} data-to-top>
  <svg class="to-top__ring" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle class="to-top__track" cx="24" cy="24" r="23.5"></circle>
    <circle class="to-top__progress" cx="24" cy="24" r="23.5" pathLength="1" data-to-top-progress></circle>
  </svg>
  <Icon name="arrow-up" size={20} />
</button>

<style>
  .to-top {
    position: fixed;
    right: max(12px, (var(--gutter) - 48px) / 2, calc(env(safe-area-inset-right) + 12px));
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: calc(var(--z-header) - 5);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--soot);
    color: var(--chalk);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility 0s linear var(--dur-fast);
  }

  .to-top:global(.is-shown) {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .to-top:global(.is-shown):active {
    transform: scale(var(--press));
  }

  /* Кольцо: бледная дорожка и линия прогресса от верхней точки по часовой */
  .to-top__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;
    fill: none;
    overflow: visible;
  }

  .to-top__track {
    stroke: var(--graphite);
    stroke-width: 1;
    transition: stroke var(--dur-fast) var(--ease-out);
  }

  .to-top__progress {
    stroke: var(--chalk);
    stroke-width: 1.25;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .to-top:hover .to-top__track {
      stroke: var(--ash);
    }
  }

  :global(.menu-open) .to-top {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transform: none;
    }
  }
</style>
