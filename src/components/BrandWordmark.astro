---
/**
 * Надпись VANTEGRA по центру экрана — блок после первого экрана.
 * Источник — SVG владельца (src/assets/brand/logo/vantegra-wordmark-chalk.svg, та же надпись,
 * что logo/svg/vantegra-wordmark-on-soot.svg, без фона). Геометрия не меняется: те же контуры,
 * только разложены по буквам, чтобы прорисовывать их по очереди; в конце надпись совпадает с оригиналом.
 *
 * Надпись не «приезжает снизу»: пока она ниже центра, её не видно; когда встаёт в центр экрана,
 * останавливается (sticky) на время прорисовки. Прорисовку ведёт прокрутка (scripts/brand.ts):
 * пыль первого экрана становится линией → контуры букв обводятся от середины слова к краям →
 * буквы заливаются мелом, контур и линия гаснут → надпись уходит вверх, сразу за ней «О студии».
 * Без JS и при prefers-reduced-motion надпись стоит целиком, без остановки.
 */
import raw from '../assets/brand/logo/vantegra-wordmark-chalk.svg?raw';

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1];
const d = raw.match(/<path[^>]*\sd="([^"]+)"/)?.[1];
if (!viewBox || !d) throw new Error('BrandWordmark: в SVG надписи нет viewBox или контура');
if (/[^MLZ\d\s.,-]/i.test(d)) throw new Error('BrandWordmark: ожидались только команды M, L, Z');

/** Подконтуры → буквы: перекрывающиеся по горизонтали подконтуры — одна буква (перекладины A, E, T, ножка R) */
const parts = d
  .split(/(?=M)/)
  .map((part) => part.trim())
  .filter(Boolean)
  .map((part) => {
    const numbers = (part.match(/-?\d*\.?\d+/g) ?? []).map(Number);
    const xs = numbers.filter((_, i) => i % 2 === 0);
    const ys = numbers.filter((_, i) => i % 2 === 1);
    return { part, x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys), y1: Math.max(...ys) };
  })
  .sort((a, b) => a.x0 - b.x0);

const letters: { d: string; x0: number; x1: number }[] = [];
for (const part of parts) {
  const last = letters.at(-1);
  if (last && part.x0 < last.x1) {
    last.d += part.part;
    last.x1 = Math.max(last.x1, part.x1);
  } else {
    letters.push({ d: part.part, x0: part.x0, x1: part.x1 });
  }
}

const [, , vbWidth, vbHeight] = viewBox.split(/\s+/).map(Number);
const top = Math.min(...parts.map((part) => part.y0));
const bottom = Math.max(...parts.map((part) => part.y1));
const mid = (top + bottom) / 2; // средняя линия букв: сюда ложится пыль
const center = (letters.length - 1) / 2;
const left = letters[0]?.x0 ?? 0;
const right = letters.at(-1)?.x1 ?? 0;
const ratio = ((vbHeight ?? 1) / (vbWidth ?? 1)).toFixed(5);
---

<div class="brand-track" data-brand-track style={`--ratio: ${ratio}`}>
  <div class="brand-stage" data-brand-stage>
    <div class="brand-mark" data-brand data-vb-width={vbWidth}>
      <svg
        viewBox={viewBox}
        role="img"
        aria-label="Vantegra"
        focusable="false"
        data-letters={`${left} ${top} ${right} ${bottom}`}
      >
        <line class="brand-mark__line" x1="0" x2={vbWidth} y1={mid} y2={mid} data-brand-line />
        {
          letters.map((letter, i) => (
            <g data-letter data-order={Math.floor(Math.abs(i - center))}>
              <path class="brand-mark__fill" d={letter.d} />
              <path class="brand-mark__outline" d={letter.d} pathLength="1" />
            </g>
          ))
        }
      </svg>
    </div>
  </div>
</div>

<style>
  /* Ширина надписи и высота сцены (по пропорциям viewBox) */
  .brand-track {
    --w: min(64vw, 1100px);
    --h: calc(var(--w) * var(--ratio));
    --pin: 70svh;

    padding-block: var(--space-6) var(--space-4);
  }

  @media (max-width: 767px) {
    .brand-track {
      --w: calc(100vw - 2 * var(--gutter));
      --pin: 50svh;
    }
  }

  .brand-stage {
    display: grid;
    place-items: center;
    height: var(--h);
  }

  .brand-mark {
    width: var(--w);
  }

  .brand-mark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .brand-mark__fill {
    fill: var(--chalk);
  }

  .brand-mark__outline {
    fill: none;
    stroke: var(--chalk);
    stroke-width: var(--sw, 2);
    stroke-linejoin: miter;
    opacity: 0;
  }

  .brand-mark__line {
    stroke: var(--chalk);
    stroke-width: var(--sw, 2);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ---------- Остановка в центре и прорисовка (только с JS и без reduced motion) ---------- */

  @media (prefers-reduced-motion: no-preference) {
    /* место под остановку: сцена «едет» по этому отрезку, оставаясь в центре экрана */
    :global(.js) .brand-track::after {
      content: '';
      display: block;
      height: var(--pin);
    }

    :global(.js) .brand-stage {
      position: sticky;
      top: calc(50svh - var(--h) / 2);
    }

    :global(.js) .brand-mark__fill {
      opacity: 0;
    }

    :global(.js) .brand-mark__outline {
      opacity: 1;
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
    }
  }
</style>
