---
/**
 * Кнопка: основная — мел на саже, вторичная — прозрачная с рамкой пепла.
 * Geologica 13 px, заглавные, разрядка 0,24em, высота 52 px (малая — 44 px), скругление pill.
 * fill — вторичная с рамкой мелом, при наведении заливается мелом кругом из точки, где курсор вошёл
 * в кнопку, и стекает в точку выхода (решение владельца; точки ставит scripts/button-fill.ts).
 * Надпись под заливкой — сажей ровно по краю круга: копия надписи внутри круга с обратным масштабом.
 * arrow — круглая кнопка со стрелкой вместо надписи (лента «назад / вперёд»), имя — через aria-label.
 * icon — иконка перед надписью; plain — надпись как есть, без заглавных и разрядки (контакты в блоке
 * «Обсудим проект»: капсулы с заливкой, решение владельца 04.10.2026).
 */
import Arrow from './Arrow.astro';
import Icon, { type IconName } from './Icon.astro';
import { t } from '../lib/typograf.ts';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit' | 'reset';
  label?: string;
  class?: string;
  external?: boolean;
  [key: `data-${string}`]: string | boolean | undefined;
  [key: `aria-${string}`]: string | boolean | undefined;
  id?: string;
  disabled?: boolean;
  /** заливка от точки входа курсора — только у вторичной */
  fill?: boolean;
  /** круглая кнопка со стрелкой вместо надписи */
  arrow?: 'left' | 'right';
  /** иконка перед надписью */
  icon?: IconName;
  /** надпись как есть: без заглавных и разрядки, крупнее обычной кнопки */
  plain?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  label,
  class: className,
  external = false,
  fill = false,
  arrow,
  icon,
  plain = false,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, fill && 'btn--fill', arrow && 'btn--icon', plain && 'btn--plain', className];
const text = label ? t(label) : undefined;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a class:list={classes} href={href} {...externalAttrs} {...rest}>
      <span class="btn__label">
        {arrow && <Arrow direction={arrow} />}
        {icon && <Icon name={icon} size={18} />}
        {text}
        <slot />
      </span>
      {
        fill && (
          <span class="btn__flood" aria-hidden="true">
            <span class="btn__flood-text">
              <span class="btn__label">
                {arrow && <Arrow direction={arrow} />}
                {icon && <Icon name={icon} size={18} />}
                {text}
              </span>
            </span>
          </span>
        )
      }
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <span class="btn__label">
        {arrow && <Arrow direction={arrow} />}
        {icon && <Icon name={icon} size={18} />}
        {text}
        <slot />
      </span>
      {
        fill && (
          <span class="btn__flood" aria-hidden="true">
            <span class="btn__flood-text">
              <span class="btn__label">
                {arrow && <Arrow direction={arrow} />}
                {icon && <Icon name={icon} size={18} />}
                {text}
              </span>
            </span>
          </span>
        )
      }
    </button>
  )
}

<style>
  @property --fill {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .btn {
    --btn-fg: var(--soot);
    --btn-bg: var(--chalk);
    --btn-line: var(--chalk);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: var(--btn-h);
    padding: 0 var(--btn-px);
    border: var(--hairline) solid var(--btn-line);
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-button);
    line-height: 1;
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* компенсация разрядки после последней буквы */
  .btn__label {
    margin-right: calc(var(--ls-button) * -1);
  }

  .btn--sm {
    min-height: var(--btn-h-sm);
    padding: 0 var(--btn-px-sm);
  }

  /* круглая со стрелкой: ширина равна высоте, стрелка 20 px */
  .btn--icon {
    width: var(--btn-h);
    padding: 0;
    font-size: var(--fs-list);
  }

  .btn--icon.btn--sm {
    width: var(--btn-h-sm);
  }

  .btn--icon .btn__label {
    display: flex;
    margin-right: 0;
  }

  /* иконка перед надписью — на одной линии с текстом */
  .btn__label:has(:global(svg)) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* надпись как есть (контакты): Geologica 300 без заглавных и разрядки, крупнее, по ширине текста */
  .btn--plain {
    justify-content: flex-start;
    min-height: calc(var(--btn-h) + var(--space-1));
    padding: 0 var(--space-5);
    font-weight: 300;
    font-size: var(--fs-pill);
    letter-spacing: 0;
    text-transform: none;
  }

  .btn--plain .btn__label {
    margin-right: 0;
  }

  .btn--plain .btn__flood-text {
    justify-content: flex-start;
    padding: 0 var(--space-5);
  }

  .btn--secondary {
    --btn-fg: var(--chalk);
    --btn-bg: transparent;
    --btn-line: var(--ash);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover {
      --btn-bg: transparent;
      --btn-fg: var(--chalk);
      --btn-line: var(--chalk);
    }

    .btn--secondary:hover {
      --btn-line: var(--chalk);
    }
  }

  .btn:active {
    transform: scale(var(--press));
  }

  /* Состояния для /styleguide/ */
  .btn--primary.is-hover {
    --btn-bg: transparent;
    --btn-fg: var(--chalk);
    --btn-line: var(--chalk);
  }

  .btn--secondary.is-hover {
    --btn-line: var(--chalk);
  }

  .btn.is-focus {
    outline: 2px solid var(--chalk);
    outline-offset: 3px;
  }

  .btn:disabled {
    cursor: default;
    --btn-bg: transparent;
    --btn-fg: var(--ash);
    --btn-line: var(--graphite);
    transform: none;
  }

  /* На светлой секции цвета наоборот */
  :global(.section--chalk) .btn--primary {
    --btn-fg: var(--chalk);
    --btn-bg: var(--soot);
    --btn-line: var(--soot);
  }

  :global(.section--chalk) .btn--secondary {
    --btn-fg: var(--soot);
    --btn-line: var(--ash-on-chalk);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.section--chalk) .btn--primary:hover {
      --btn-bg: transparent;
      --btn-fg: var(--soot);
      --btn-line: var(--soot);
    }

    :global(.section--chalk) .btn--secondary:hover {
      --btn-line: var(--soot);
    }
  }

  /* ---------- Заливка от точки входа курсора ----------
     --fill (0…1) плавно меняется переходом; круг заливки масштабируется от точки входа (--fx, --fy),
     его диаметр --fd накрывает кнопку целиком; копия надписи внутри круга масштабируется обратно
     и стоит на месте — под заливкой надпись сажей ровно по краю круга. Точки и размеры — button-fill.ts */

  .btn--fill {
    --btn-line: var(--chalk);

    overflow: hidden;
    isolation: isolate;
    transition:
      --fill 560ms var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .btn--fill.is-filled {
    --fill: 1;
  }

  .btn__flood {
    position: absolute;
    top: calc(var(--fy, 50%) - var(--fd, 0px) / 2);
    left: calc(var(--fx, 50%) - var(--fd, 0px) / 2);
    z-index: 1;
    width: var(--fd, 0px);
    height: var(--fd, 0px);
    overflow: hidden;
    border-radius: 50%;
    background: var(--chalk);
    transform: scale(var(--fill));
    pointer-events: none;
  }

  .btn__flood-text {
    position: absolute;
    top: calc(var(--fd, 0px) / 2 - var(--fy, 0px));
    left: calc(var(--fd, 0px) / 2 - var(--fx, 0px));
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--bw, 100%);
    height: var(--bh, 100%);
    color: var(--soot);
    transform-origin: var(--fx, 50%) var(--fy, 50%);
    /* обратный масштаб; у самого начала ограничен, чтобы не растить надпись в сотни раз — круг там в точку */
    transform: scale(calc(1 / max(var(--fill), 0.05)));
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }

    .btn--fill {
      transition: none;
    }
  }
</style>
