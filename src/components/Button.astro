---
/**
 * Кнопка: основная — мел на саже, вторичная — прозрачная с рамкой пепла.
 * Geologica 13 px, заглавные, разрядка 0,24em, высота 52 px (малая — 44 px), скругление pill.
 * orbit — вторичная с рамкой мелом: капсула — отсылка к орбите (tokens.css), поэтому при наведении
 * по её контуру обегает «планета» с коротким хвостом, как в фактах «О студии» (вместо стрелки).
 */
import { t } from '../lib/typograf.ts';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit' | 'reset';
  label?: string;
  class?: string;
  external?: boolean;
  [key: `data-${string}`]: string | boolean | undefined;
  [key: `aria-${string}`]: string | boolean | undefined;
  id?: string;
  disabled?: boolean;
  /** планета на контуре капсулы — только у вторичной */
  orbit?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  label,
  class: className,
  external = false,
  orbit = false,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, orbit && 'btn--orbit', className];
// радиус контура = половина высоты капсулы без волоса рамки: --btn-h 52 px, --btn-h-sm 44 px (tokens-extra.css)
const radius = size === 'sm' ? 21.5 : 25.5;
const text = label ? t(label) : undefined;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a class:list={classes} href={href} {...externalAttrs} {...rest}>
      <span class="btn__label">
        {text}
        <slot />
      </span>
      {
        orbit && (
          <svg class="btn__orbit" aria-hidden="true" focusable="false">
            <rect class="btn__trail" width="100%" height="100%" rx={radius} pathLength="100" />
            <rect class="btn__planet" width="100%" height="100%" rx={radius} pathLength="100" />
          </svg>
        )
      }
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <span class="btn__label">
        {text}
        <slot />
      </span>
      {
        orbit && (
          <svg class="btn__orbit" aria-hidden="true" focusable="false">
            <rect class="btn__trail" width="100%" height="100%" rx={radius} pathLength="100" />
            <rect class="btn__planet" width="100%" height="100%" rx={radius} pathLength="100" />
          </svg>
        )
      }
    </button>
  )
}

<style>
  .btn {
    --btn-fg: var(--soot);
    --btn-bg: var(--chalk);
    --btn-line: var(--chalk);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: var(--btn-h);
    padding: 0 var(--btn-px);
    border: var(--hairline) solid var(--btn-line);
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-button);
    line-height: 1;
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* компенсация разрядки после последней буквы */
  .btn__label {
    margin-right: calc(var(--ls-button) * -1);
  }

  .btn--sm {
    min-height: var(--btn-h-sm);
    padding: 0 var(--btn-px-sm);
  }

  .btn--secondary {
    --btn-fg: var(--chalk);
    --btn-bg: transparent;
    --btn-line: var(--ash);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover {
      --btn-bg: transparent;
      --btn-fg: var(--chalk);
      --btn-line: var(--chalk);
    }

    .btn--secondary:hover {
      --btn-line: var(--chalk);
    }
  }

  .btn:active {
    transform: scale(var(--press));
  }

  /* Состояния для /styleguide/ */
  .btn--primary.is-hover {
    --btn-bg: transparent;
    --btn-fg: var(--chalk);
    --btn-line: var(--chalk);
  }

  .btn--secondary.is-hover {
    --btn-line: var(--chalk);
  }

  .btn.is-focus {
    outline: 2px solid var(--chalk);
    outline-offset: 3px;
  }

  .btn:disabled {
    cursor: default;
    --btn-bg: transparent;
    --btn-fg: var(--ash);
    --btn-line: var(--graphite);
    transform: none;
  }

  /* На светлой секции цвета наоборот */
  :global(.section--chalk) .btn--primary {
    --btn-fg: var(--chalk);
    --btn-bg: var(--soot);
    --btn-line: var(--soot);
  }

  :global(.section--chalk) .btn--secondary {
    --btn-fg: var(--soot);
    --btn-line: var(--ash-on-chalk);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.section--chalk) .btn--primary:hover {
      --btn-bg: transparent;
      --btn-fg: var(--soot);
      --btn-line: var(--soot);
    }

    :global(.section--chalk) .btn--secondary:hover {
      --btn-line: var(--soot);
    }
  }

  /* ---------- Капсула-орбита: рамка мелом, при наведении по контуру бежит планета ---------- */

  .btn--orbit {
    --btn-line: var(--chalk);
  }

  /* контур — точно по линии рамки: холст на полволоса шире блока отступов в каждую сторону */
  .btn__orbit {
    position: absolute;
    inset: calc(var(--hairline) * -0.5);
    width: calc(100% + var(--hairline));
    height: calc(100% + var(--hairline));
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--chalk);
  }

  .btn__planet,
  .btn__trail {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* планета — точка с круглыми концами; хвост — короткая полоса позади неё */
  .btn__planet {
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 0.001 99.999;
    animation: btn-planet 2.6s linear infinite paused;
  }

  /* хвост кончается ровно у планеты: его сдвиг = сдвиг планеты + длина хвоста */
  .btn__trail {
    stroke-width: 2;
    stroke-dasharray: 9 91;
    animation: btn-trail 2.6s linear infinite paused;
  }

  @keyframes btn-planet {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -100;
    }
  }

  @keyframes btn-trail {
    from {
      stroke-dashoffset: 9;
    }

    to {
      stroke-dashoffset: -91;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--orbit:hover :is(.btn__planet, .btn__trail) {
      animation-play-state: running;
    }

    .btn--orbit:hover .btn__planet {
      opacity: 1;
    }

    .btn--orbit:hover .btn__trail {
      opacity: 0.5;
    }
  }

  .btn--orbit:focus-visible :is(.btn__planet, .btn__trail),
  .btn--orbit.is-hover :is(.btn__planet, .btn__trail) {
    animation-play-state: running;
  }

  .btn--orbit:focus-visible .btn__planet,
  .btn--orbit.is-hover .btn__planet {
    opacity: 1;
  }

  .btn--orbit:focus-visible .btn__trail,
  .btn--orbit.is-hover .btn__trail {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }

    .btn__planet,
    .btn__trail {
      animation: none;
    }
  }
</style>
