---
/**
 * Работа на главной («Избранные проекты»): скриншот главной страницы сайта (обложка кейса `cover.*`,
 * 16:10) в рамке мелом, под ним название, кто клиент и год. Решение владельца: пока только скриншоты —
 * без ссылок на сайты и без страниц кейсов.
 */
import { Picture } from 'astro:assets';
import { works as text } from '../data/pages.ts';
import type { Work } from '../lib/content.ts';
import { t } from '../lib/typograf.ts';

interface Props {
  work: Work;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { work, headingLevel: Heading = 'h3', eager = false } = Astro.props;
---

<article class="work" data-services={work.services.join(' ')}>
  <div class="work__shot">
    <Picture
      src={work.cover}
      alt={`${text.shotAlt} ${work.title}`}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1024px) 31vw, (min-width: 768px) 46vw, 84vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="work__body">
    <Heading class="work__title h3">{t(work.title)}</Heading>
    <!-- год приклеен неразрывным пробелом: «· 2026» не уходит в начало строки -->
    <p class="work__meta eyebrow">
      {t(work.client ?? text.nda)}<span class="work__year">&nbsp;·&nbsp;{work.year}</span>
    </p>
  </div>
</article>

<style>
  .work {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .work__shot {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: var(--hairline) solid var(--chalk);
  }

  .work__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__body {
    display: grid;
    gap: var(--space-3);
  }

  .work__year {
    white-space: nowrap;
  }
</style>
