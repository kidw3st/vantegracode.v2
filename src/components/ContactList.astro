---
/**
 * Контакты строками: подпись + значение Geologica 300.
 * md — 22–28 px (блок CTA), xl — 28–32 px и кнопки «Скопировать» (страница «Контакты»).
 */
import { site } from '../data/site.ts';
import { ui } from '../data/ui.ts';

interface Props {
  size?: 'md' | 'xl';
  copy?: boolean;
  class?: string;
}

const { size = 'md', copy = false, class: className } = Astro.props;

const items = [
  { key: 'telegram', label: ui.contacts.telegram, value: site.telegram.handle, href: site.telegram.url, external: true },
  { key: 'email', label: ui.contacts.email, value: site.email, href: `mailto:${site.email}`, external: false },
  { key: 'phone', label: ui.contacts.phone, value: site.phone.display, href: `tel:${site.phone.tel}`, external: false },
];
---

<dl class:list={['contacts', `contacts--${size}`, className]}>
  {
    items.map((item) => (
      <div class="contacts__row">
        <dt class="eyebrow contacts__label">{item.label}</dt>
        <dd class="contacts__value">
          <a
            class="contacts__link num"
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="link">{item.value}</span>
          </a>
          {copy && (
            <button
              class="contacts__copy"
              type="button"
              data-copy={item.value}
              data-copied={ui.contacts.copied}
              aria-label={`${ui.contacts.copy}: ${item.value}`}
            >
              <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M7 7h10v10H7zM3 13V3h10" />
              </svg>
              <span class="contacts__tip" data-copy-tip aria-live="polite" />
            </button>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .contacts {
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }

  .contacts__row {
    display: grid;
    gap: var(--space-2);
  }

  .contacts__value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    min-width: 0;
  }

  .contacts__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-contact);
    line-height: 1.1;
    white-space: nowrap;
  }

  .contacts--xl .contacts__link {
    font-size: var(--fs-contact-xl);
  }

  /* 320–359 px: адрес почты с кнопкой копирования не влезает в 28 px */
  @media (max-width: 359px) {
    .contacts__link,
    .contacts--xl .contacts__link {
      font-size: 1.375rem;
    }
  }

  .contacts__link .link {
    font-family: inherit;
  }

  @media (hover: hover) and (pointer: fine) {
    .contacts__link:hover .link::after {
      transform: scaleX(1);
    }
  }

  .contacts__copy {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--tap);
    height: var(--tap);
    border: var(--hairline) solid var(--graphite);
    border-radius: var(--radius-pill);
    color: var(--ash);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .contacts__copy svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  @media (hover: hover) and (pointer: fine) {
    .contacts__copy:hover {
      border-color: var(--ash);
      color: var(--chalk);
    }
  }

  .contacts__copy:active {
    transform: scale(var(--press));
  }

  /* Подсказка над кнопкой, выровнена по правому краю — не выходит за экран */
  .contacts__tip {
    position: absolute;
    right: 0;
    bottom: calc(100% + var(--space-2));
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-tag);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--chalk);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .contacts__copy.is-copied .contacts__tip {
    opacity: 1;
  }
</style>
