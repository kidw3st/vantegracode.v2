---
/**
 * Контакты строками: подпись + значение Geologica 300.
 * md — 22–28 px (блок CTA), xl — 28–32 px (страница «Контакты»); copy — кнопки «Скопировать».
 * pills — капсулами с заливкой от точки входа курсора, как «Все цены» (решение владельца 04.10.2026):
 * над каждой — подпись (Telegram, Почта, Телефон), как у полей формы; иконка и значение крупно, капсулы
 * одной ширины (по самой длинной), круглая «Скопировать» — у правого края колонки; без подчёркиваний
 * и подчёркиваний, подпись — для чтения с экрана (карточка «Обсудим проект»).
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../data/site.ts';
import { ui } from '../data/ui.ts';

interface Props {
  size?: 'md' | 'xl';
  copy?: boolean;
  pills?: boolean;
  /** подписи над капсулами (Telegram, Почта, Телефон); в подвале их нет — там заголовок колонки */
  labels?: boolean;
  class?: string;
}

const { size = 'md', copy = false, pills = false, labels = true, class: className } = Astro.props;

const items = [
  { key: 'telegram', icon: 'telegram', label: ui.contacts.telegram, value: site.telegram.handle, href: site.telegram.url, external: true },
  { key: 'email', icon: 'mail', label: ui.contacts.email, value: site.email, href: `mailto:${site.email}`, external: false },
  { key: 'phone', icon: 'phone', label: ui.contacts.phone, value: site.phone.display, href: `tel:${site.phone.tel}`, external: false },
] as const;
---

{
  pills ? (
    <ul class:list={['contacts-pills', { 'contacts-pills--plain': !labels }, className]} role="list">
      {items.map((item) => (
        <li class="contacts-pills__row">
          {labels && <span class="eyebrow contacts-pills__label" aria-hidden="true">{item.label}</span>}
          <Button
            href={item.href}
            external={item.external}
            variant="secondary"
            fill
            plain
            icon={item.icon}
            label={item.value}
            aria-label={`${item.label}: ${item.value}`}
          />
          {copy && (
            <button
              class="contacts__copy"
              type="button"
              data-copy={item.value}
              data-copied={ui.contacts.copied}
              aria-label={`${ui.contacts.copy}: ${item.value}`}
            >
              <Icon name="copy" size={18} />
              <span class="contacts__tip" data-copy-tip aria-live="polite" />
            </button>
          )}
        </li>
      ))}
    </ul>
  ) : (
<dl class:list={['contacts', `contacts--${size}`, className]}>
  {
    items.map((item) => (
      <div class="contacts__row">
        <dt class="eyebrow contacts__label">
          <Icon name={item.icon} size={18} class="contacts__icon" />
          {item.label}
        </dt>
        <dd class="contacts__value">
          <a
            class="contacts__link num"
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="link">{item.value}</span>
          </a>
          {copy && (
            <button
              class="contacts__copy"
              type="button"
              data-copy={item.value}
              data-copied={ui.contacts.copied}
              aria-label={`${ui.contacts.copy}: ${item.value}`}
            >
              <Icon name="copy" size={18} />
              <span class="contacts__tip" data-copy-tip aria-live="polite" />
            </button>
          )}
        </dd>
      </div>
    ))
  }
</dl>
  )
}

<style>
  /* ---------- pills: капсулы с заливкой ---------- */
  /* две колонки на весь список: капсулы одной ширины слева, «Скопировать» — у правого края */
  .contacts-pills {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: center;
    gap: var(--space-6) var(--space-4);
  }

  .contacts-pills__row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    row-gap: var(--space-2);
  }

  /* без подписей капсулы стоят плотнее */
  .contacts-pills--plain {
    row-gap: var(--space-3);
  }

  /* подпись над капсулой — как у полей формы; для чтения с экрана она уже в имени капсулы */
  .contacts-pills__label {
    grid-column: 1 / -1;
  }

  .contacts-pills .contacts__copy {
    justify-self: end;
  }

  /* до 389 px капсула с почтой и «Скопировать» в одну строку: поля капсул уже;
     до 359 px — ещё и без иконки */
  @media (max-width: 389px) {
    .contacts-pills :global(.btn) {
      padding-inline: var(--space-4);
    }
  }

  @media (max-width: 359px) {
    .contacts-pills {
      column-gap: var(--space-3);
    }

    .contacts-pills :global(.btn svg) {
      display: none;
    }
  }

  .contacts {
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }

  .contacts__row {
    display: grid;
    gap: var(--space-2);
  }

  /* Иконка перед подписью — цветом подписи */
  .contacts__label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contacts__value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    min-width: 0;
  }

  .contacts__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-contact);
    line-height: 1.1;
    white-space: nowrap;
  }

  .contacts--xl .contacts__link {
    font-size: var(--fs-contact-xl);
  }

  /* 320–359 px: адрес почты с кнопкой копирования не влезает в 28 px */
  @media (max-width: 359px) {
    .contacts__link,
    .contacts--xl .contacts__link {
      font-size: 1.375rem;
    }
  }

  .contacts__link .link {
    font-family: inherit;
  }

  @media (hover: hover) and (pointer: fine) {
    .contacts__link:hover .link::after {
      transform: scaleX(1);
    }
  }

  .contacts__copy {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--tap);
    height: var(--tap);
    border: var(--hairline) solid var(--graphite);
    border-radius: var(--radius-pill);
    color: var(--ash);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }


  @media (hover: hover) and (pointer: fine) {
    .contacts__copy:hover {
      border-color: var(--ash);
      color: var(--chalk);
    }
  }

  .contacts__copy:active {
    transform: scale(var(--press));
  }

  /* Подсказка над кнопкой, выровнена по правому краю — не выходит за экран */
  .contacts__tip {
    position: absolute;
    right: 0;
    bottom: calc(100% + var(--space-2));
    font-family: var(--font-tech);
    font-variation-settings: var(--tech-variation);
    font-weight: 400;
    font-size: var(--fs-tag);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--chalk);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .contacts__copy.is-copied .contacts__tip {
    opacity: 1;
  }
</style>
