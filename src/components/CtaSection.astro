---
/** Финальный блок: заголовок по центру (как у всех блоков), под ним слева контакты, справа форма. Бледные орбиты на фоне. */
import ContactList from './ContactList.astro';
import SectionHeader from './SectionHeader.astro';
import LeadForm from './LeadForm.astro';
import OrbitField from './OrbitField.astro';
import { contactBlock } from '../data/pages.ts';
import { getText } from '../lib/fill.ts';

interface Props {
  /** номер секции на странице: «06 — Контакт» */
  num?: number;
}

const { num } = Astro.props;
const text = await getText();
const eyebrow = num ? `${String(num).padStart(2, '0')} — ${contactBlock.label}` : contactBlock.label;
---

<section class="section cta" aria-labelledby="cta-title">
  <OrbitField mode="block" rings={3} tone="faint" start={0.3} />
  <div class="container cta__inner">
    <SectionHeader id="cta-title" eyebrow={text(eyebrow)} title={text(contactBlock.title)} text={text(contactBlock.text)} />
    <div class="grid cta__grid">
      <div class="cta__info" data-reveal>
        <ContactList class="cta__contacts" />
      </div>
      <div class="cta__form" data-reveal>
        <LeadForm />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    overflow: hidden;
  }

  .cta__inner {
    position: relative;
    z-index: var(--z-content);
  }

  .cta__grid {
    row-gap: var(--space-9);
  }

  .cta__info,
  .cta__form {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .cta__info {
      grid-column: 1 / span 5;
    }

    .cta__form {
      grid-column: 7 / -1;
    }
  }
</style>
