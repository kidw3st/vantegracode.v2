---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandWordmark from '../components/BrandWordmark.astro';
import Button from '../components/Button.astro';
import CtaSection from '../components/CtaSection.astro';
import Logo from '../components/Logo.astro';
import OrbitField from '../components/OrbitField.astro';
import PriceCard from '../components/PriceCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FactCard from '../components/FactCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceIdea from '../components/ServiceIdea.astro';
import ProcessScreen from '../components/ProcessScreen.astro';
import WorkCard from '../components/WorkCard.astro';
import Icon from '../components/Icon.astro';
import { home, steps } from '../data/pages.ts';
import { site } from '../data/site.ts';
import { getPrices, getServices, getWorks } from '../lib/content.ts';
import { getText, PLACEHOLDER } from '../lib/fill.ts';
import { protectedBox } from '../lib/logo.ts';
import { logoRings } from '../lib/orbit.ts';
import { website } from '../lib/seo.ts';
import { t } from '../lib/typograf.ts';

const [services, prices, works, text] = await Promise.all([getServices(), getPrices(), getWorks(), getText()]);

// До 3 кейсов с featured: true; если отмеченных нет — последние. Нет кейсов — блока нет.
const featured = works.filter((work) => work.featured);
const homeWorks = (featured.length ? featured : works).slice(0, 3);
const showWorks = homeWorks.length > 0;
const serviceNames = Object.fromEntries(services.map((service) => [service.id, service.data.title]));

// Номера в подписях идут подряд по блокам, которые реально выводятся
// Структура владельца: О студии → Процесс → Что делаем → Работы → Цены → Контакты («Работы» всегда, без кейсов — заглушки).
// Процесс сразу за фактами «О студии» показывает, как выполняются их обещания; услуги, работы и цены — подряд, одним блоком предложения
const order = ['about', 'process', 'services', 'works', 'prices', 'contact'];
const num = (key: string) => order.indexOf(key) + 1;
const eyebrow = (key: string, label: string) => `${String(num(key)).padStart(2, '0')} — ${label}`;

const priceById = new Map(prices.map((price) => [price.id, price]));
const priceCards = home.prices.cards.map((card) => {
  const price = priceById.get(card.price);
  if (!price) throw new Error(`Главная: нет позиции «${card.price}» в prices.yaml`);
  return { title: card.title, price: price.data.price, term: price.data.term };
});

// Внутренний край пылевого диска = первая эхо-орбита вокруг вертикального блока (в ширинах логотипа)
const verticalBox = protectedBox('vertical');
const [innerOrbit] = logoRings({ hw: verticalBox.hw, hh: verticalBox.hh, rings: 1 });
const discRim = innerOrbit?.rx ?? 2.6;

const filledSteps = steps.map((step) => ({
  title: step.title,
  text: text(step.text),
  more: text(step.more),
  result: step.result.map(text),
  icon: step.icon,
}));
const secondary = showWorks
  ? { href: site.cta.worksHref, label: site.cta.works }
  : { href: site.cta.servicesHref, label: site.cta.services };
---

<BaseLayout seo={{ ...home.seo, jsonLd: [website()] }}>
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__disc" aria-hidden="true" data-hero-disc data-rim={discRim.toFixed(4)}></canvas>
    <div class="hero__inner container">
      <div class="hero__logo">
        <OrbitField mode="logo" logo="vertical" unit="var(--hero-logo)" rings={4} tone="normal" draw="auto" />
        <div class="hero__art" data-hero-logo>
          {/* Знак: модель из Blender (tools/hero-mark.py), вращается в реальном времени (scripts/hero.ts).
              До первого кадра и без WebGL — плоский SVG; в анфас они совпадают */}
          <Logo variant="mark" width={300} cssWidth="var(--hero-logo)" minWidth={160} class="hero__mark" fetchpriority="high" />
          <canvas class="hero__canvas" width="720" height="560" aria-hidden="true" data-hero-canvas data-src="/media/hero-mark.bin"
          ></canvas>
          <Logo
            variant="wordmark"
            width={297}
            cssWidth="calc(var(--hero-logo) * 0.99009)"
            minWidth={158}
            alt="Vantegra"
            class="hero__wordmark"
          />
        </div>
      </div>
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title" data-hero="settle" style="--i: 0">
          {
            home.hero.title.map((line, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    {' '}
                    <br />
                  </Fragment>
                )}
                {t(line)}
              </Fragment>
            ))
          }
        </h1>
        <p class="lead hero__lead" data-hero="settle" style="--i: 1">
          {
            home.hero.lead.map((sentence, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    {' '}
                    <br />
                  </Fragment>
                )}
                {t(sentence)}
              </Fragment>
            ))
          }
        </p>
        <div class="hero__actions" data-hero="rise" style="--i: 2">
          <Button href={site.cta.discussHref} label={site.cta.discuss} />
          <Button href={secondary.href} variant="secondary" label={secondary.label} />
        </div>
      </div>
    </div>
  </section>

  {/* Надпись по центру экрана: на её среднюю линию ложится пыль первого экрана, буквы прорисовываются на месте */}
  <BrandWordmark />

  <section class="section about" aria-labelledby="about-title">
    <div class="container">
      {/* без подписи «01 — О студии» (решение владельца); у остальных блоков подписи пока остаются */}
      <SectionHeader id="about-title" title={home.about.title} neon />
      <ul class="facts rail" role="list" data-reveal="stagger" data-facts>
        {
          home.about.facts.map((fact, i) => (
            <FactCard index={i} total={home.about.facts.length} title={fact.label} text={fact.text} icon={fact.icon} />
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <SectionHeader id="process-title" title={home.process.title} />
      <ProcessScreen steps={filledSteps} resultLabel={home.process.result} screen={home.process.screen} />
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader
        id="services-title"
        title={home.services.title}
      />
      <ul class="cards cards--3 rail" role="list" data-reveal="stagger">
        {
          services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
      <ServiceIdea {...home.services.idea} href="#cta-title" class="services-idea" />
      <!-- все услуги — кнопка-капсула под «Вашей идеей», по оси блока (решение владельца) -->
      <div class="services-more" data-reveal>
        <Button href="/uslugi/" variant="secondary" neon label={home.services.link} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="works-title">
    <div class="container">
      <SectionHeader
        id="works-title"
        eyebrow={eyebrow('works', home.works.label)}
        title={home.works.title}
        link={{ href: '/raboty/', label: home.works.link }}
      />
      {
        showWorks ? (
          <div class="home-works" data-reveal="stagger">
            {homeWorks.map((work, i) => (
              <WorkCard work={work} serviceNames={serviceNames} size={i === 0 ? 'lg' : 'md'} />
            ))}
          </div>
        ) : (
          <ul class="home-works rail" role="list" data-reveal="stagger">
            {Array.from({ length: home.works.placeholders }, (_, i) => (
              <li class="work-stub">
                <div class="work-stub__media">
                  <Icon name="orbit" size={40} />
                </div>
                <p class="work-stub__meta eyebrow">{`${home.works.placeholder} ${String(i + 1).padStart(2, '0')}`}</p>
                <h3 class="work-stub__title">{PLACEHOLDER}</h3>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>


  <section class="section" aria-labelledby="prices-title">
    <div class="container">
      <SectionHeader
        id="prices-title"
        eyebrow={eyebrow('prices', home.prices.label)}
        title={home.prices.title}
        link={{ href: '/ceny/', label: home.prices.link }}
      />
      <ul class="cards cards--3 rail" role="list" data-reveal="stagger">
        {
          priceCards.map((card) => (
            <li>
              <PriceCard title={card.title} price={card.price} term={card.term} />
            </li>
          ))
        }
      </ul>
      <p class="prices-note" data-reveal>{t(home.prices.note)}</p>
    </div>
  </section>

  <CtaSection num={num('contact')} />
</BaseLayout>

<style>
  /* ---------- Первый экран ---------- */

  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding-top: var(--header-h);
    overflow: clip;
  }

  /* Пылевой диск: под кольцами и текстом, проявляется после первого кадра */
  .hero__disc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero__disc.is-ready {
    opacity: 1;
  }

  /* Переход к блокам: холст закреплён на экране, диск сплющивается и ложится
     на линию следующего блока (scripts/disc.ts, hero-scroll.ts) */
  .hero__disc.is-fixed {
    position: fixed;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__disc {
      transition-duration: var(--dur-fast);
    }
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    padding-block: var(--space-5);
  }

  /* Блок повторяет вертикальный логотип: viewBox 962.81 × 939.71, все размеры — доли его ширины */
  .hero__logo {
    position: relative;
    width: var(--hero-logo);
    aspect-ratio: 962.81 / 939.71;
    margin-bottom: clamp(var(--space-6), 4.6vh, var(--space-7));
  }

  .hero__art {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
  }

  /* Плоский знак — на месте знака в вертикальном блоке (верхняя часть, viewBox 962.81 × 733.04) */
  .hero__art :global(.hero__mark) {
    position: absolute;
    left: 0;
    top: 0;
  }

  /* Холст: кадр камеры 2,25 × 1,75 ед. при ширине знака 2 ед., центр — центр знака. Фон прозрачный */
  .hero__canvas {
    position: absolute;
    left: calc(var(--hero-logo) * -0.0625);
    top: calc(var(--hero-logo) * -0.05683);
    width: calc(var(--hero-logo) * 1.125);
    height: calc(var(--hero-logo) * 0.875);
    max-width: none;
    pointer-events: none;
  }

  /* Пока 3D не нарисовал первый кадр — виден SVG; потом наоборот */
  .hero__art:not(.is-3d) .hero__canvas,
  .hero__art.is-3d :global(.hero__mark) {
    visibility: hidden;
  }

  /* Надпись — на том же месте, что в вертикальном блоке */
  .hero__art :global(.hero__wordmark) {
    position: absolute;
    left: calc(var(--hero-logo) * 0.004955);
    top: calc(var(--hero-logo) * 0.75985);
    z-index: 1;
  }

  .hero__copy {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    justify-items: center;
  }

  /* Оптическая середина: у «Студия» тяжёлые штамбы справа (Д, И, Я) и круглая С слева —
     первая строка сдвинута влево на 0,08 em, ось проходит между серединой рамки и центром масс */
  .hero__title {
    padding-inline-start: var(--ls-display);
    text-indent: -0.16em;
  }

  /* «Студия / разработки» — короткие строки помещаются и на телефоне: кегль и разрядка как на десктопе */
  @media (max-width: 480px) {
    .hero__title {
      font-size: var(--fs-h1);
      letter-spacing: var(--ls-display);
    }
  }

  /* Каждая фраза лида — с новой строки, переносы внутри фразы выровнены */
  .hero__lead {
    margin-top: clamp(var(--space-4), 2.4vh, var(--space-5));
    margin-inline: auto;
    text-wrap: balance;
  }

  /* Кнопки равной ширины (по более широкой): ось экрана проходит ровно через зазор */
  .hero__actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: clamp(var(--space-6), 4.4vh, var(--space-7));
  }

  @media (max-width: 479px) {
    .hero__actions {
      grid-template-columns: 1fr;
      width: min(100%, 320px);
    }
  }

  /* ---------- «О студии» ---------- */

  /* Сразу за надписью: без лишнего отступа сверху */
  .about {
    padding-top: var(--space-6);
  }

  /* Четыре факта — карточки FactCard: на десктопе в ряд, на планшете 2 × 2, на телефоне лентой вправо (.rail) */
  @media (min-width: 768px) {
    .facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---------- «Работы»: заглушки, пока нет кейсов ---------- */

  .work-stub {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .work-stub__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-2);
    border: var(--hairline) solid var(--graphite);
    color: var(--graphite);
  }

  .work-stub__meta {
    color: var(--ash);
  }

  .work-stub__title {
    font-size: var(--fs-h3);
  }

  /* ---------- Сетки карточек ---------- */

  .cards {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .cards--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .prices-note {
    margin-top: var(--space-6);
    color: var(--ash);
  }

  /* «Ваша идея» — под карточками услуг, с тем же шагом, что между карточками */
  :global(.services-idea) {
    margin-top: var(--space-3);
  }

  .services-more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
  }

  /* ---------- Работы ---------- */

  .home-works {
    display: grid;
    gap: var(--space-7) var(--column-gap);
  }

  @media (min-width: 1024px) {
    .home-works {
      grid-template-columns: 7fr 5fr;
    }

    .home-works > :first-child {
      grid-row: span 2;
    }
  }
</style>
